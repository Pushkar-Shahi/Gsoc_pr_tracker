# ==============================================================================
# Issue-to-PR Platform: Production Environment Configuration Template
# Copy this file to .env or inject these variables into your Cloud Host
# (Render, Railway, Fly.io, AWS ECS, GCP Cloud Run, or Kubernetes)
# ==============================================================================

# --- Server & Core Security ---
# Secret key for JWT session tokens and cryptographic signatures (min 32 chars)
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_cryptographically_secure_random_string_in_production
# Dynamic container port (cloud PaaS providers automatically populate PORT)
PORT=8000
# Environment indicator (production / staging / development)
ENVIRONMENT=production

# --- Database Configuration ---
# Standard PostgreSQL connection string.
# Render, Railway, Supabase, and Neon provide postgres:// or postgresql://
# The platform automatically normalizes this to postgresql+asyncpg://
DATABASE_URL=postgresql://postgres:secure_production_password@db-host:5432/issuetopr

# --- GitHub Integration (OAuth App or GitHub App) ---
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret
GITHUB_REDIRECT_URI=https://your-domain.com/api/v1/auth/github/callback
FRONTEND_AUTH_CALLBACK_URL=https://your-domain.com/auth/callback
# Webhook secret configured on your GitHub App or repository webhooks
GITHUB_WEBHOOK_SECRET=your_production_webhook_secret_hmac_32_chars
# Optional personal access token for higher unauthenticated rate limits (fallback)
GITHUB_TOKEN=

# --- Google OAuth 2.0 Integration ---
# Retrieve from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=842489213804-lnvakm6obbd26vj8qsdi8s3ri3fq1aev.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Stripe Billing & Monetization ---
# Retrieve from Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_live_51...
STRIPE_PUBLISHABLE_KEY=pk_live_51...
# Webhook signing secret from Stripe Dashboard -> Developers -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Product Price IDs (create in Stripe Dashboard or use default monthly/annual)
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_live
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual_live
STRIPE_TEAM_SEAT_PRICE_ID=price_team_monthly_live
BILLING_SUCCESS_URL=https://your-domain.com/?billing=success
BILLING_CANCEL_URL=https://your-domain.com/?billing=cancel
FREE_TIER_MONTHLY_TASK_LIMIT=5

# --- Bounty Hunter Hub (Polar.sh & Algora) ---
# Personal Access Token for live Polar API ingestion (https://polar.sh/settings)
# If omitted, platform serves verified cached and fallback high-value bounties
POLAR_ACCESS_TOKEN=

# --- Distributed Queue & Scaling (Optional) ---
# Redis broker URL for multi-worker distributed queuing (e.g. redis://redis:6379/0)
# If omitted or offline, platform transparently uses non-blocking in-memory asyncio queue
REDIS_URL=

# --- Sandboxed Execution Provider ---
# Provider selection: "local", "docker", or "e2b"
# Default is "local" (fast Git worktrees).
WORKSPACE_PROVIDER=local
# Optional E2B API Key for ephemeral cloud micro-VM sandboxes (https://e2b.dev)
E2B_API_KEY=

# --- Storage & Cache Locations ---
# Persistent volume path inside container (mount persistent volume here)
# DATA_DIR=/app/data

